# Skopiuj ten plik jako .env i uzupełnij to, z czego chcesz korzystać.
# Plik .env jest w .gitignore - nie trafi na GitHuba.

# Alert na Discordzie: Ustawienia kanału -> Integracje -> Webhooki -> Nowy webhook -> Kopiuj URL
DISCORD_WEBHOOK_URL=

# Alert e-mailem (np. Gmail: smtp.gmail.com, port 465, hasło aplikacji z ustawień konta Google)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_HASLO=
ALERT_EMAIL_DO=
